# Get these from https://dashboard.plaid.com/developers/keys (use the *Sandbox* secret)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Comma separated. CA needs Canada enabled on your Plaid account; sandbox works with US out of the box.
PLAID_COUNTRY_CODES=US,CA
PLAID_PRODUCTS=transactions
# Sandbox institution used by the "quick link" shortcut (First Platypus Bank)
PLAID_SANDBOX_INSTITUTION=ins_109508

# Public HTTPS URL for POST /webhooks/plaid (e.g. an ngrok tunnel to :4000). Optional in dev:
# without it, findings refresh on pull-to-refresh or SCAN_INTERVAL_HOURS.
PLAID_WEBHOOK_URL=

# ---- Encryption (see SECURITY.md) ----
# local = master key from MASTER_KEY below (development). kms = AWS KMS (production).
KEY_PROVIDER=local
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
# Id stored with every ciphertext. To rotate: move the old one to OLD_MASTER_KEYS as "id:key", set a new id + key.
MASTER_KEY_ID=k1
OLD_MASTER_KEYS=

# Rescan every user every N hours as a fallback for missed webhooks (0 = off).
SCAN_INTERVAL_HOURS=0

PORT=4000
DATABASE_PATH=./looni.db
