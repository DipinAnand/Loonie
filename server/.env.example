# Get these from https://dashboard.plaid.com/developers/keys (use the *Sandbox* secret)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Comma separated. CA needs Canada enabled on your Plaid account; sandbox works with US out of the box.
PLAID_COUNTRY_CODES=US,CA
PLAID_PRODUCTS=transactions
# Sandbox institution used by the "quick link" shortcut (First Platypus Bank)
PLAID_SANDBOX_INSTITUTION=ins_109508

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

PORT=4000
DATABASE_PATH=./looni.db
